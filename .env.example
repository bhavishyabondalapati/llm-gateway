# Copy to .env and fill in. Everything is optional: with no keys set,
# the gateway uses fake providers and runs fully offline.

# Real providers (enabled only when set)
OPENAI_API_KEY=your-openai-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here

# Tracing: send spans to an OTLP/HTTP collector (Jaeger in docker-compose)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_CONSOLE_EXPORTER=false

# Protect the dashboard (empty = open, fine for local dev)
# DASHBOARD_TOKEN=change-me

# Tuning
# PII_ENABLED=true
# PII_SCORE_THRESHOLD=0.4
# CACHE_ENABLED=true
# SEMANTIC_CACHE_ENABLED=true
# SEMANTIC_CACHE_THRESHOLD=0.96
# MAX_RETRIES=2
# DATABASE_PATH=data/gateway.db
